{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "node_modules/.tmp/.tsbuildinfo-lib",
    "types": ["node"]
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.spec.ts"]
}
