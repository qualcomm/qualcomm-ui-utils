{
  "name": "@qualcomm-ui/changesets-cli",
  "version": "3.0.0",
  "description": "Changeset automation CLI for conventional commits",
  "license": "BSD-3-Clause-Clear",
  "author": "Ryan Bower",
  "repository": "https://github.com/qualcomm/qualcomm-ui-utils",
  "bin": {
    "qui-changesets": "./lib/cli.js"
  },
  "files": [
    "dist",
    "lib"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean compile",
    "clean": "shx rm -rf dist node_modules/.tmp",
    "compile": "run-p compile:cli compile:changesets-cli compile:types",
    "compile:cli": "vite build",
    "compile:changesets-cli": "vite build -c vite-changelog.config.ts",
    "compile:types": "tsc -b tsconfig.lib.json --force",
    "dev": "run-p watch:cli watch:changesets-cli watch:types",
    "watch:cli": "vite build -w",
    "watch:changesets-cli": "vite build -c vite-changelog.config.ts -w",
    "watch:types": "tsc -b tsconfig.lib.json -w --preserveWatchOutput --force",
    "test": "vitest -c vitest.config.ts --run",
    "lint": "eslint --quiet",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@changesets/read": "^1.0.0",
    "@changesets/types": "^7.0.0",
    "@changesets/write": "^1.0.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@manypkg/get-packages": "^3.1.0",
    "@octokit/rest": "^22.0.1",
    "@qualcomm-ui/cli": "workspace:*",
    "@qualcomm-ui/vite": "workspace:*",
    "commander": "^14.0.3",
    "dayjs": "^1.11.19",
    "ts-morph": "^25.0.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@actions/core": ">=1.11.1",
    "@changesets/read": ">=1.0.0",
    "@changesets/types": ">=7.0.0",
    "@changesets/write": ">=1.0.0",
    "@commander-js/extra-typings": ">=14.0.0",
    "@manypkg/get-packages": ">=3.1.0",
    "@octokit/rest": "^22.0.1",
    "commander": ">=14.0.3",
    "dayjs": ">=1.11.19",
    "ts-morph": ">=25.0.1"
  }
}
