{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "../packages/changesets-cli/dist/changelog-formatter.cjs",
    { "repo": "https://github.com/qualcomm/qualcomm-ui-utils" }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "changedFilePatterns": [
    "**",
    "!dist",
    "!build",
    "!CHANGELOG.md",
    "!node_modules",
    "!.turbo",
    "!scripts",
    "!vite.config.ts",
    "!vitest.config.ts"
  ],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": []
}
